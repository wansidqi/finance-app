{
  "expo": {
    "name": "Zakat Tracker",
    "slug": "zakat-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/zakat.png",
    "scheme": "zakattracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/zakat.png",
        "backgroundImage": "./assets/images/zakat.png",
        "monochromeImage": "./assets/images/zakat.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lumvyr.zakattracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/zakat.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#10b981"
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "wansidqi",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "677db663-3760-405d-a2ba-ea6a348cc622"
      }
    }
  }
}
